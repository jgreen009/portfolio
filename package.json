{
  "name": "michael-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 5181",
    "build": "next build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/site.test.mjs",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "test:all": "npm run typecheck && npm run build && npm test && playwright test",
    "test:seo": "node scripts/verify-configured-seo.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "audit": "node scripts/measure-browser.mjs",
    "audit:lighthouse": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  }
}
